include README.md CONTRIBUTING.md .env.example .gitignore
include start-demo.command
recursive-include docs *.md
include docs/LOCAL_UPSTREAM_REVIEW.json
include docs/LOCAL_VALIDATION.json
recursive-include scripts *.py *.sh
recursive-include tests *.py *.json *.jsonl *.md *.txt LICENSE .gitattributes
recursive-include third_party *
include dependencies/README.md dependencies/PINNED.md dependencies/ASSETS.json
global-exclude __pycache__ *.py[cod] *.log

recursive-include assets *.png *.gif *.mp4
